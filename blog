.article-layout{display:grid;grid-template-columns:1fr 260px;gap:60px;padding:60px 0 90px;align-items:start;}
.article-content{max-width:760px;}
.article-content > *{margin-bottom:22px;}
.article-content h2{font-size:1.5rem;font-weight:800;margin-top:44px;color:#fff;}
