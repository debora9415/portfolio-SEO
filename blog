*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;}
.container{width:90%;max-width:1200px;margin:auto;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(12,12,12,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--border);}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:14px 5%;max-width:1200px;margin:auto;}
.nav-logo{font-weight:800;font-size:1rem;color:var(--text);text-decoration:none;}
.nav-logo span{background:var(--gradient);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.nav-links{display:flex;gap:24px;list-style:none;}
.nav-links a{color:var(--muted);text-decoration:none;font-size:.85rem;font-weight:500;transition:.2s;}
.nav-links a:hover,.nav-links a.active{color:#fff;}
.nav-cta{padding:9px 22px;background:var(--gradient);color:white;border-radius:10px;text-decoration:none;font-size:.85rem;font-weight:700;transition:.3s;}
.nav-cta:hover{opacity:.85;transform:translateY(-2px);}
.nav-toggle{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
.nav-toggle span{display:block;width:22px;height:2px;background:var(--muted);border-radius:2px;}
@media(max-width:768px){
  .nav-links{display:none;}.nav-cta{display:none;}.nav-toggle{display:flex;}
  .nav-links.open{display:flex;flex-direction:column;position:absolute;top:100%;left:0;right:0;background:rgba(12,12,12,.98);padding:20px 5%;border-bottom:1px solid var(--border);gap:18px;}
  .nav-links.open a{font-size:1rem;}
}

/* ARTICLE HEADER */
.article-header{padding:150px 0 40px;background:radial-gradient(circle at top right,rgba(233,30,140,.14) 0%,transparent 45%),var(--bg);}
.breadcrumb{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:.82rem;margin-bottom:24px;flex-wrap:wrap;}
.breadcrumb a{color:var(--muted);text-decoration:none;transition:.2s;}
.breadcrumb a:hover{color:var(--pink);}
.post-tag{display:inline-block;background:rgba(233,30,140,.1);border:1px solid rgba(233,30,140,.3);color:var(--pink);font-size:.7rem;font-weight:700;padding:5px 14px;border-radius:20px;text-transform:uppercase;letter-spacing:.03em;margin-bottom:18px;}
.article-header h1{font-size:clamp(1.9rem,4.5vw,3rem);font-weight:800;line-height:1.2;margin-bottom:22px;max-width:850px;}
.article-meta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:var(--muted);font-size:.85rem;padding-bottom:30px;border-bottom:1px solid var(--border);}
.author-chip{display:flex;align-items:center;gap:10px;}
.author-chip img{width:38px;height:38px;border-radius:50%;object-fit:cover;border:2px solid rgba(233,30,140,.4);}
.author-chip strong{color:#fff;font-size:.85rem;display:block;}
.dot{width:3px;height:3px;background:var(--muted);border-radius:50%;}
.article-meta span{display:flex;align-items:center;gap:5px;}
.article-meta svg{width:14px;height:14px;stroke:#6b7280;stroke-width:2;fill:none;}

/* COVER IMAGE */
.cover{width:100%;max-width:1200px;margin:36px auto 0;border-radius:22px;overflow:hidden;aspect-ratio:21/9;background:linear-gradient(135deg,rgba(233,30,140,.2),rgba(139,0,224,.2));display:flex;align-items:center;justify-content:center;}
.cover img{width:100%;height:100%;object-fit:cover;display:block;}
.cover svg{width:56px;height:56px;stroke:var(--pink);stroke-width:1.4;fill:none;opacity:.7;}

